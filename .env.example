# ==============================================================================
# AgentGuard AI — Production Environment Variables Template
# Copy this file to .env and fill in the values for your deployment.
# NEVER commit .env or secrets to version control.
# ==============================================================================

# ── Supabase Infrastructure ───────────────────────────────────────────────────
# Find these in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable anon key (safe for browser client)
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOi...
# Secret service role key (FastAPI backend and Arq worker ONLY - NEVER expose to browser)
SUPABASE_SECRET_KEY=eyJhbGciOi...
# Optional direct/pooled PostgreSQL connection string for asyncpg
SUPABASE_DB_URL=postgresql+asyncpg://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# ── Backend Configuration ─────────────────────────────────────────────────────
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=http://localhost:5173,https://agentguard-alpha-teal.vercel.app
API_PREFIX=/api

# ── Redis & Arq Asynchronous Queue ────────────────────────────────────────────
# Redis connection string for background scan worker (e.g. Upstash or Render Redis)
REDIS_URL=redis://localhost:6379/0

# ── Security Scanners ─────────────────────────────────────────────────────────
SEMGREP_ENABLED=true
BANDIT_ENABLED=true
OSV_ENABLED=true
SCAN_TIMEOUT_SECONDS=900
MAX_REPOSITORY_SIZE_MB=100

# ── NVIDIA Nemotron AI (Optional) ─────────────────────────────────────────────
# Obtain free/cloud API key from https://build.nvidia.com
NVIDIA_NEMOTRON_API_KEY=
NVIDIA_NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_NEMOTRON_ENABLED=false

# ── GitHub Integration (Optional) ─────────────────────────────────────────────
# Server-side GitHub personal access token for higher GitHub REST API rate limits
GITHUB_TOKEN=

# ── Storage & Artifact Expiry ─────────────────────────────────────────────────
# Time in seconds before private download URLs expire (default 600s = 10 mins)
SIGNED_URL_EXPIRY_SECONDS=600
