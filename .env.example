# Database (SQLite for local standalone, or Supabase PostgreSQL for cloud/staging/production)
# SQLite dev default: sqlite+aiosqlite:///./agentguard.db
# Supabase Pooler (IPv4/IPv6 session mode): postgresql+asyncpg://postgres.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./agentguard.db

# Supabase Project Config (optional - for Supabase client & edge functions)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# AI Provider — NVIDIA Nemotron with LangGraph 4-Agent Orchestration
# Default: 'mock' (works with zero credentials, deterministic 4-agent security reasoning)
# Set AI_PROVIDER=nemotron and supply NVIDIA_API_KEY for real LLM reasoning
AI_PROVIDER=mock
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_API_KEY=
AI_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# NVIDIA aliases (optional alternative to AI_*)
# NVIDIA_API_KEY=nvapi-...
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Upload limits
MAX_UPLOAD_SIZE_MB=50

# Sandbox (requires Docker — disabled if Docker unavailable)
SANDBOX_CPU_LIMIT=0.5
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_NETWORK_DISABLED=true

# GitHub Integration (Optional - Public repos work with NO token)
# Configure a fine-grained Personal Access Token (PAT) with read-only repository permissions
# for higher rate limits or private repository access. Never commit real tokens.
GITHUB_TOKEN=
SCAN_WORKSPACE_DIR=./scan_workspaces
SCAN_TIMEOUT_SECONDS=120
GIT_CLONE_TIMEOUT_SECONDS=300

# Auth — CHANGE before any real deployment
JWT_SECRET=CHANGE_ME_BEFORE_PRODUCTION

# Environment
ENVIRONMENT=development
DEBUG=false

# Background Worker & Job Queue (arq + Redis)
# For local dev / testing, if omitted or empty, AgentGuard AI falls back to in-memory async processing.
# In production, provide an external Redis instance URL (e.g. Upstash, Redis Cloud, or Render Redis).
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=agentguard:scans
MAX_JOB_RETRIES=3

# Scalability Quotas, Limits & Backpressure (Milestone B)
MAX_CONCURRENT_SCANS_PER_USER=2
MAX_DAILY_SCANS_PER_USER=50
MAX_QUEUE_DEPTH=100
RATE_LIMIT_PER_MINUTE_API=60
RATE_LIMIT_PER_MINUTE_SCAN=10
MAX_REPO_CLONE_SIZE_MB=500

# Database Pool Sizing (Sized for Supabase 60-connection cap across web + worker processes)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Workspace Sandbox Isolation (Milestone C)
WORKSPACE_MAX_AGE_SECONDS=3600
