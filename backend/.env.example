# ==============================================================================
# AgentGuard AI — Backend Environment Variables Template
# Copy to backend/.env
# ==============================================================================

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=postgresql+asyncpg://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./agentguard.db

# ── Backend Server ────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:5173,https://agentguard-alpha-teal.vercel.app
API_PREFIX=/api
ENVIRONMENT=development

# ── Redis / Arq Worker ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security Scanners ─────────────────────────────────────────────────────────
SEMGREP_ENABLED=true
BANDIT_ENABLED=true
OSV_ENABLED=true
SCAN_TIMEOUT_SECONDS=900
MAX_REPOSITORY_SIZE_MB=100

# ── NVIDIA Nemotron AI ────────────────────────────────────────────────────────
NVIDIA_NEMOTRON_API_KEY=
NVIDIA_NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_NEMOTRON_ENABLED=false

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=

# ── Storage ───────────────────────────────────────────────────────────────────
SIGNED_URL_EXPIRY_SECONDS=600
