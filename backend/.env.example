# AgentGuard AI Backend Environment Configuration
DATABASE_URL=postgresql+asyncpg://postgres.<project_ref>:<db_password>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
ENABLE_DEMO_AUTH=false

# AI Provider
AI_PROVIDER=mock
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_API_KEY=
AI_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Upload Limits
MAX_UPLOAD_SIZE_MB=50

# Environment
ENVIRONMENT=development
DEBUG=false

# Scanner Timeouts
SEMGREP_RULE_TIMEOUT_SECONDS=0
SCANNER_JOB_MAX_RUNTIME_SECONDS=1800
