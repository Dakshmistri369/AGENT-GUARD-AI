{
  "name": "agentguard-ai-root",
  "private": true,
  "description": "AgentGuard AI Workspace Root",
  "scripts": {
    "dev": "concurrently -k -n \"backend,frontend\" -c \"blue,green\" \"npm run backend\" \"npm run frontend\"",
    "start": "npm run dev",
    "backend": "python -m uvicorn app.main:app --app-dir backend --reload --reload-dir backend --port 8000",
    "frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "test:backend": "python -m pytest backend/tests/ -v",
    "test": "npm --prefix frontend run build && python -m pytest backend/tests/ -v"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
