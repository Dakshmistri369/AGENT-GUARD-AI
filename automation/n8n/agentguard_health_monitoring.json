{
  "name": "AgentGuard - Health Monitoring",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "cron-trigger",
      "name": "Every 5 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-500, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.AGENTGUARD_API_BASE}}/health",
        "options": {
          "timeout": 5000
        }
      },
      "id": "health-check",
      "name": "Check AgentGuard Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-280, 0]
    },
    {
      "parameters": {
        "conditions": {
          "conditions": [
            {
              "leftValue": "={{$json.status}}",
              "rightValue": "healthy",
              "operator": { "type": "string", "operation": "equals" }
            },
            {
              "leftValue": "={{$json.status}}",
              "rightValue": "ready",
              "operator": { "type": "string", "operation": "equals" }
            }
          ],
          "combinator": "or"
        }
      },
      "id": "if-healthy",
      "name": "If Healthy",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-60, 0]
    },
    {
      "parameters": {},
      "id": "noop-healthy",
      "name": "System Healthy (No-Op)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [160, -80]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": "={{$env.SLACK_OPS_CHANNEL_ID}}",
        "text": "=:warning: *AgentGuard Health Degradation Alert*\nTarget: {{$env.AGENTGUARD_API_BASE}}/health\nReported Status: {{$json.status || 'UNREACHABLE / TIMEOUT'}}\nDatabase: {{$json.database || 'unknown'}}\nTimestamp: {{$now.toISO()}}\nIncident classified as infrastructure degradation — check Render logs.",
        "otherOptions": {}
      },
      "id": "slack-health-alert",
      "name": "Slack: Health Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [160, 100],
      "credentials": { "slackApi": { "id": "SLACK_CRED_ID", "name": "AgentGuard Slack" } }
    }
  ],
  "connections": {
    "Every 5 Minutes": {
      "main": [[{ "node": "Check AgentGuard Health", "type": "main", "index": 0 }]]
    },
    "Check AgentGuard Health": {
      "main": [[{ "node": "If Healthy", "type": "main", "index": 0 }]]
    },
    "If Healthy": {
      "main": [
        [{ "node": "System Healthy (No-Op)", "type": "main", "index": 0 }],
        [{ "node": "Slack: Health Alert", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "errorWorkflow": "AGENTGUARD_ERROR_HANDLER_WORKFLOW_ID",
    "saveExecutionProgress": true
  }
}
