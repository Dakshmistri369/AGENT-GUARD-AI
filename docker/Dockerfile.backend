# Stage 1: Build
FROM python:3.13-slim AS builder
WORKDIR /build
COPY backend/requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt --target /deps

# Stage 2: Runtime
FROM python:3.13-slim AS runtime
LABEL org.opencontainers.image.title="AgentGuard AI Backend"

# Non-root user
RUN groupadd -r agentguard && useradd -r -g agentguard agentguard

WORKDIR /app
COPY --from=builder /deps /deps
ENV PYTHONPATH=/deps:/app

COPY backend/app ./app
COPY backend/alembic ./alembic
COPY backend/alembic.ini .

RUN chown -R agentguard:agentguard /app
USER agentguard

EXPOSE 8000

# Migrations run as an EXPLICIT step — not silently baked into startup.
# In production: docker run --entrypoint python ... -m alembic upgrade head
# Then start the server:
CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
