# ==============================================================================
# AgentGuard AI — Frontend Environment Variables Template
# Copy to frontend/.env or frontend/.env.local
# ONLY publishable keys are placed here. NEVER put service role keys in frontend.
# ==============================================================================

# Supabase Project URL
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase Anon / Publishable Key (safe for browser)
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# FastAPI Backend URL (leave empty on Vercel to use the same-origin /api rewrite proxy)
VITE_API_BASE_URL=http://localhost:8000
